# ==============================================================================
# JAINUNE BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local runtime or staging/prod secrets manager.
# ==============================================================================

# RUNTIME & APP
ENVIRONMENT=development
DEBUG=true
APP_VERSION=1.0.0
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8081","http://192.168.0.6:8081","jainune://"]
SENTRY_DSN=
METRICS_SECRET_TOKEN=dev_metrics_secret_token_16chars

# DATABASE (PostgreSQL 16 + pgvector)
DATABASE_URL=postgresql://postgres:password@localhost:5432/jainune_dev
DATABASE_POOL_MIN_SIZE=2
DATABASE_POOL_MAX_SIZE=10
DATABASE_STATEMENT_TIMEOUT_MS=5000

# Docker Compose overrides (development defaults only; never use this database
# password for a network-accessible or production database).
POSTGRES_DB=jainune_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
# Optional image override for docker-compose.prod.yml; normally supplied by CI.
BACKEND_IMAGE=

# IN-MEMORY CACHE & PUBSUB (Redis 7+)
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_MAX_CONNECTIONS=20
REDIS_FALLBACK_URL=

# AUTHENTICATION & JWT (RS256 asymmetric + HMAC grace)
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=./secrets/jwt_rsa.key
JWT_PUBLIC_KEY_PATH=./secrets/jwt_rsa.pub
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_SECRET_KEY=dev_hmac_secret_32_characters_minimum_len
OTP_PEPPER_SECRET=dev_otp_pepper_secret_32_chars_len

# OAUTH & MOBILE BUNDLE IDENTIFIERS
GOOGLE_CLIENT_ID=dev-google-client-id.apps.googleusercontent.com
APPLE_BUNDLE_ID=

# Google Play server-side purchase verification. Set one-line service-account
# JSON in Render (never in a mobile build) when testing Play Billing.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# Web Push (required for installed iPhone PWA notifications). Generate one
# P-256 VAPID key pair; keep the private key server-side only.
# Generate once with: python scripts/generate_web_push_keys.py
# Put the private value in Render's secret environment, never in a client build.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:noreply@jainune.com


# SUPABASE STORAGE (Avatars & Media)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=avatars

# MSG91 (SMS & WhatsApp Delivery)
MSG91_AUTH_KEY=mock_msg91_auth_key
MSG91_OTP_TEMPLATE_ID=mock_otp_template_id
MSG91_WHATSAPP_TEMPLATE_ID=mock_whatsapp_template_id
MSG91_PROMOTIONAL_FLOW_ID=

# TRANSACTIONAL EMAIL (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=noreply@jainune.com
EMAIL_FROM_NAME=Jainune

# FIREBASE CLOUD MESSAGING (Push Notifications)
FCM_SERVICE_ACCOUNT_PATH=./secrets/fcm_service_account.json
# Alternative to FCM_SERVICE_ACCOUNT_PATH for Render secret environment.
FCM_SERVICE_ACCOUNT_JSON=
FCM_PROJECT_ID=jainune-dev

# RAZORPAY PAYMENT GATEWAY
RAZORPAY_KEY_ID=rzp_test_mock_key_id
RAZORPAY_KEY_SECRET=mock_rzp_key_secret
RAZORPAY_WEBHOOK_SECRET=mock_rzp_webhook_secret

# REVERSE PROXY, WAF & ANTI-BOT
CLOUDFLARE_ORIGIN_SECRET=
TURNSTILE_SECRET_KEY=
REQUIRE_EDGE_LOCATION_CORROBORATION=false

# CLOUDFLARE WORKERS AI (Photo Moderation — Single Token Hybrid Gate)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CF_AI_VISION_MODEL=@cf/meta/llama-3.2-11b-vision-instruct
CF_AI_MODERATION_ENABLED=true
CF_AI_DAILY_NEURON_CAP=9500
CF_AI_MAX_RPM=15

# APP STORE & GOOGLE PLAY WEBHOOKS
STORE_WEBHOOK_SECRET=
WEBHOOK_SECRET=

# Legacy settings retained only for backwards-compatible tests; leave empty.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
