# ENVIRONMENT & RUNTIME
ENVIRONMENT=development
DEBUG=true
APP_VERSION=1.0.0
ALLOWED_ORIGINS=["http://localhost:3000","jainune://"]

# DATABASE (SUPABASE POSTGRESQL 15+)
DATABASE_URL=postgresql://postgres:password@localhost:5432/jainune_dev
DATABASE_POOL_MIN_SIZE=2
DATABASE_POOL_MAX_SIZE=10
DATABASE_STATEMENT_TIMEOUT_MS=2000

# IN-MEMORY CACHE (REDIS 7+)
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_MAX_CONNECTIONS=20

# JWT / AUTH
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=./secrets/jwt_rsa.key
JWT_PUBLIC_KEY_PATH=./secrets/jwt_rsa.pub
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
OTP_PEPPER_SECRET=change-me-32-bytes-hex-string-here

# AWS S3
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_QUARANTINE_BUCKET=jainune-media-quarantine
AWS_S3_PRODUCTION_BUCKET=jainune-media-production
CDN_PUBLIC_BASE_URL=https://cdn.jainune.com

# MSG91
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_OTP_TEMPLATE_ID=your-template-id

# RAZORPAY
RAZORPAY_KEY_ID=rzp_test_key_id
RAZORPAY_KEY_SECRET=rzp_test_secret
RAZORPAY_WEBHOOK_SECRET=webhook-secret-here
