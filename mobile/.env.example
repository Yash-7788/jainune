# ==============================================================================
# JAINUNE MOBILE ENVIRONMENT CONFIGURATION TEMPLATE (EXPO)
# Copy to .env for local runtime.
# ==============================================================================

# API Base URL
# - Local Wi-Fi device / Expo Go: http://<YOUR_LOCAL_IP>:8000/v1
# - Android Emulator: http://10.0.2.2:8000/v1
# - iOS Simulator / Web: http://localhost:8000/v1
# - Production: https://api.jainune.com/v1
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/v1

# WebSocket Base URL
# - Local Wi-Fi device / Expo Go: ws://<YOUR_LOCAL_IP>:8000/v1/ws/chat
# - Android Emulator: ws://10.0.2.2:8000/v1/ws/chat
# - iOS Simulator / Web: ws://localhost:8000/v1/ws/chat
# - Production: wss://api.jainune.com/v1/ws/chat
EXPO_PUBLIC_WS_URL=ws://10.0.2.2:8000/v1/ws/chat

# Google Sign-In Web Client ID (OAuth 2.0 Web Client)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com

# Razorpay Key ID (India payments)
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID

# Billing Provider Override (optional: "play_billing" | "app_store" | "razorpay")
# Defaults to "app_store" on iOS, "play_billing" on Android
EXPO_PUBLIC_BILLING_PROVIDER=

# Release APK Signing SHA-256 Fingerprint (optional: enforces anti-tamper on release APKs)
EXPO_PUBLIC_RELEASE_CERT_SHA256=

# Expo project UUID for Expo push notifications (public identifier).
EXPO_PUBLIC_EAS_PROJECT_ID=

# Set to production in a release job; validates explicit HTTPS/WSS endpoints.
JAINUNE_BUILD_ENV=development
