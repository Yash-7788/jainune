# Jainune Mobile — Local Development Environment Variables
# Copy this to .env and fill in values for your environment

# API base URL — point to local backend or staging
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/v1

# Google OAuth Web Client ID (get from Google Cloud Console)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com

# Billing provider override (for Expo Go testing, set to "razorpay" or leave default)
# EXPO_PUBLIC_BILLING_PROVIDER=razorpay

# Release certificate SHA-256 (leave empty for development)
EXPO_PUBLIC_RELEASE_CERT_SHA256=
